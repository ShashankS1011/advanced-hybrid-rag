# ==============================================================================
# Production Hybrid RAG Engine - Environment Configuration
# ==============================================================================

# Groq API Configuration (Required for LLM generation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Storage & Vector Database
CHROMA_DB_DIR=./chroma_db
CHROMA_COLLECTION_NAME=advanced_hybrid_rag

# Embedding Model (HuggingFace / Sentence Transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEVICE=cpu

# Ingestion & Chunking Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Hybrid Retrieval Candidates
DENSE_K=12
SPARSE_K=12
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5

# FlashRank Cross-Encoder Reranker
RERANK_TOP_N=4
RERANK_MODEL=ms-marco-TinyBERT-L-2-v2

# Generation Parameters
TEMPERATURE=0.1
SCORE_THRESHOLD=0.0

